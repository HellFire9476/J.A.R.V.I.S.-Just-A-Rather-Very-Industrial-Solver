
/* ==========================================
   J.A.R.V.I.S. 2.0
   Industrial Dark Theme
   ========================================== */

QWidget {
    background-color: #111820;
    color: #E6EDF3;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
    border: none;
}

/* Fenetre principale */

QMainWindow {
    background-color: #111820;
}

/* Barre superieure */

QFrame#TopBar {
    background-color: #151E28;
    border-bottom: 1px solid #2A3745;
}

QLabel#TopbarVersion {
    color: #F0A044;
    font-size: 9pt;
    font-weight: 700;
}

QLabel#TopbarProject {
    color: #96A7B7;
    font-size: 8pt;
    font-weight: 600;
}

/* Menu lateral */

QWidget#Sidebar {
    background-color: #151E28;
    border-right: 1px solid #2A3745;
}

QLabel#BrandTitle {
    color: #F2F5F8;
    font-size: 23pt;
    font-weight: 800;
}

QLabel#BrandSubtitle {
    color: #E99A3C;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#SectionLabel {
    color: #718397;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}


QPushButton#NavButton {
    background-color: transparent;
    color: #AFBAC6;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 5px;
    padding: 10px 12px;
    text-align: left;
    font-size: 10pt;
    font-weight: 500;
}

QPushButton#NavButton:hover {
    background-color: #202D3A;
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background-color: #342D25;
    color: #F4AE5C;
    border-left: 3px solid #F0A044;
    font-weight: 700;
}


QLabel#ProjectName {
    color: #CED7E0;
    font-size: 9pt;
    padding-top: 6px;
}

/* Titres */

QLabel#PageTitle {
    color: #F2F5F8;
    font-size: 23pt;
    font-weight: 700;
}

QLabel#PageSubtitle {
    color: #8FA0B0;
    font-size: 10pt;
}

QLabel#SectionTitle {
    color: #EDF2F6;
    font-size: 13pt;
    font-weight: 700;
}

/* Boutons de vue */



QPushButton#ModeButton {
    background-color: #202B36;
    color: #AEBBC8;
    border: 1px solid #344252;
    border-radius: 6px;
    min-width: 105px;
    min-height: 26px;
    padding: 6px 12px;
    font-size: 9pt;
}

QPushButton#ModeButton:hover {
    background-color: #293746;
}

QPushButton#ModeButton:checked {
    background-color: #3B3022;
    color: #F5B568;
    border: 1px solid #B87930;
    font-weight: 700;
}



/* Panneau d'accueil */

QFrame#WelcomePanel {
    background-color: #202D39;
    border: 1px solid #354555;
    border-radius: 11px;
}

QLabel#Eyebrow {
    color: #EAA04A;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#WelcomeTitle {
    color: #F4F6F8;
    font-size: 21pt;
    font-weight: 700;
}

QLabel#WelcomeDescription {
    color: #AEBBC8;
    font-size: 10pt;
}

/* Cartes */

QFrame#MetricCard {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 9px;
}

QFrame#MetricCard:hover {
    border: 1px solid #495A6C;
}

QLabel#MetricLabel {
    color: #94A5B5;
    font-size: 9pt;
    font-weight: 600;
}

QLabel#MetricValue {
    color: #F0F3F6;
    font-size: 23pt;
    font-weight: 700;
}

QLabel#MetricDescription {
    color: #8293A3;
    font-size: 8pt;
}

/* Bouton principal */

QPushButton#PrimaryButton {
    background-color: #E99536;
    color: #171D24;
    border: none;
    border-radius: 6px;
    padding: 11px 17px;
    font-size: 9pt;
    font-weight: 700;
}

QPushButton#PrimaryButton:hover {
    background-color: #F3AA53;
}

QPushButton#PrimaryButton:pressed {
    background-color: #C97D28;
}

/* Comportement general */

QPushButton {
    outline: none;
}

QToolTip {
    background-color: #263442;
    color: #FFFFFF;
    border: 1px solid #485B6E;
    padding: 6px;
}


/* ==========================================
   PROJECT MANAGER
   ========================================== */

QFrame#ProjectCard {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 9px;
}

QFrame#ProjectCard:hover {
    border: 1px solid #52677A;
    background-color: #202D39;
}

QFrame#EmptyProjectsCard {
    background-color: #1B2631;
    border: 1px dashed #425264;
    border-radius: 10px;
}

QLabel#ProjectTitle {
    color: #F1F4F7;
    font-size: 13pt;
    font-weight: 700;
}

QLabel#ProjectDescription {
    color: #AEBBC8;
    font-size: 9pt;
}

QLabel#ProjectMetadata {
    color: #8293A3;
    font-size: 8pt;
}

QLabel#ProjectCardIcon {
    color: #EAA04A;
    font-size: 25pt;
    font-weight: 600;
}

QLabel#EmptyProjectIcon {
    color: #EAA04A;
    font-size: 30pt;
}

QScrollArea#ProjectScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#ProjectContainer {
    background-color: transparent;
}

QLineEdit#FormInput,
QTextEdit#FormInput {
    background-color: #151F29;
    color: #E6EDF3;
    border: 1px solid #354555;
    border-radius: 5px;
    padding: 9px;
    selection-background-color: #B87930;
}

QLineEdit#FormInput:focus,
QTextEdit#FormInput:focus {
    border: 1px solid #E99536;
}

QLabel#DialogTitle {
    color: #F2F5F8;
    font-size: 17pt;
    font-weight: 700;
}

QPushButton#PrimarySmallButton {
    background-color: #E99536;
    color: #171D24;
    border: none;
    border-radius: 5px;
    padding: 8px 17px;
    font-weight: 700;
}

QPushButton#PrimarySmallButton:hover {
    background-color: #F3AA53;
}

QPushButton#SecondarySmallButton {
    background-color: #263441;
    color: #BBC7D2;
    border: 1px solid #3A4B5C;
    border-radius: 5px;
    padding: 8px 17px;
}

QPushButton#SecondarySmallButton:hover {
    background-color: #334657;
    color: #FFFFFF;
}



/* ==========================================
   J.A.R.V.I.S. 2.0
   INDUSTRIAL PARK MANAGER
   ========================================== */

QFrame#ParkIconBadge {
    background-color: #342D25;
    border: 1px solid #75552F;
    border-radius: 8px;
}

QLabel#ParkIconLabel {
    color: #F5B568;
    font-size: 18pt;
    font-weight: 800;
}

QPushButton#DangerSmallButton {
    background-color: #38272A;
    color: #E7A2A5;
    border: 1px solid #634044;
    border-radius: 5px;
    padding: 8px 17px;
}

QPushButton#DangerSmallButton:hover {
    background-color: #563337;
    color: #FFFFFF;
}

QPushButton#DangerSmallButton:pressed {
    background-color: #6A3B3F;
}

QMessageBox {
    background-color: #1B2631;
}

QMessageBox QLabel {
    color: #E6EDF3;
    background-color: transparent;
}


/* ==========================================
   CENTRE D'ARCHIVES
   ========================================== */

QFrame#ArchivePanel {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 9px;
}

QFrame#ArchiveMetricCard {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 8px;
}

QLabel#ArchiveMetricLabel {
    color: #8FA0B0;
    font-size: 8pt;
    font-weight: 700;
}

QLabel#ArchiveMetricValue {
    color: #F1F4F7;
    font-size: 19pt;
    font-weight: 700;
}

QLabel#ArchiveMutedLabel {
    color: #8293A3;
    font-size: 8pt;
}

QLabel#ArchiveInfo {
    background-color: #202D39;
    color: #B8C4CF;
    border: 1px solid #354555;
    border-radius: 6px;
    padding: 10px;
    font-size: 9pt;
}

QLabel#ArchiveInfo b {
    color: #F2F5F8;
    font-size: 10pt;
}

QLabel#ArchiveEmptyLabel {
    color: #8FA0B0;
    padding: 25px;
}

QTableWidget#ArchiveTable,
QTreeWidget#ArchiveTree {
    background-color: #151F29;
    alternate-background-color: #192531;
    color: #DCE4EB;
    border: 1px solid #2D3A48;
    border-radius: 6px;
    selection-background-color: #3B3022;
    selection-color: #F5B568;
    outline: none;
}

QTableWidget#ArchiveTable::item,
QTreeWidget#ArchiveTree::item {
    padding: 5px;
    border: none;
}

QTableWidget#ArchiveTable::item:selected,
QTreeWidget#ArchiveTree::item:selected {
    background-color: #3B3022;
    color: #F5B568;
}

QHeaderView::section {
    background-color: #202D39;
    color: #91A2B2;
    border: none;
    border-bottom: 1px solid #354555;
    padding: 8px 7px;
    font-size: 8pt;
    font-weight: 700;
}

QLineEdit#ArchiveSearch,
QComboBox#ArchiveFilter {
    background-color: #151F29;
    color: #E6EDF3;
    border: 1px solid #354555;
    border-radius: 5px;
    padding: 8px 10px;
    min-height: 20px;
}

QLineEdit#ArchiveSearch:focus,
QComboBox#ArchiveFilter:focus {
    border: 1px solid #E99536;
}

QComboBox#ArchiveFilter QAbstractItemView {
    background-color: #202D39;
    color: #E6EDF3;
    selection-background-color: #3B3022;
}

QTabWidget#ArchivePreviewTabs::pane {
    background-color: #151F29;
    border: 1px solid #2D3A48;
    border-radius: 5px;
    top: -1px;
}

QTabBar::tab {
    background-color: #202D39;
    color: #9BAAB8;
    border: 1px solid #2D3A48;
    padding: 7px 13px;
    margin-right: 3px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
}

QTabBar::tab:selected {
    background-color: #342D25;
    color: #F5B568;
    border-bottom-color: #342D25;
}

QScrollArea#ArchiveSummaryScroll {
    background-color: #151F29;
    border: 1px solid #2D3A48;
    border-radius: 5px;
}

QLabel#ArchiveSummary {
    background-color: #151F29;
    color: #C9D5DF;
    padding: 14px 16px;
    font-size: 10pt;
}

QPlainTextEdit#ArchiveJsonPreview {
    background-color: #151F29;
    color: #C9D5DF;
    border: none;
    padding: 10px;
    selection-background-color: #75552F;
    font-family: Consolas, "Cascadia Code", monospace;
    font-size: 9pt;
}

QPushButton#DangerSmallButton:disabled,
QPushButton#PrimarySmallButton:disabled {
    background-color: #26313B;
    color: #687786;
    border: 1px solid #354555;
}


/* ==========================================
   CENTRE D'ARCHIVES — VUES SIMPLIFIÉE / AVANCÉE
   ========================================== */

QPushButton#ArchiveModeButton {
    background-color: #202D39;
    color: #AEBBC8;
    border: 1px solid #3A4B5C;
    border-radius: 5px;
    padding: 7px 12px;
    min-height: 24px;
    font-weight: 600;
}

QPushButton#ArchiveModeButton:hover {
    background-color: #2B3B49;
    color: #F1F4F7;
}

QPushButton#ArchiveModeButton:checked {
    background-color: #3B3022;
    color: #F5B568;
    border: 1px solid #A56D32;
}

QFrame#ArchiveCard {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 9px;
}

QFrame#ArchiveCard:hover {
    border: 1px solid #52677A;
    background-color: #202D39;
}

QLabel#ArchiveCardIcon {
    color: #EAA04A;
    font-size: 25pt;
    font-weight: 600;
}

QScrollArea#ArchiveSimpleScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#ArchiveSimpleContainer {
    background-color: transparent;
}

/* ==========================================
   SATISFACTORY CATALOG / RECIPES
   ========================================== */

QScrollArea#CatalogDetailScroll {
    background-color: transparent;
    border: none;
}

QFrame#CatalogSummary,
QFrame#CatalogToolbar,
QFrame#CatalogPanel {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 9px;
}

QLabel#CatalogSummaryValue {
    color: #F5B568;
    font-size: 12pt;
    font-weight: 700;
}

QLabel#CatalogSummaryText,
QLabel#CatalogMuted {
    color: #8293A3;
    font-size: 9pt;
}

QLineEdit#CatalogSearch,
QComboBox#CatalogFilter {
    background-color: #151F29;
    color: #E6EDF3;
    border: 1px solid #354555;
    border-radius: 6px;
    padding: 8px 10px;
    min-height: 20px;
}

QLineEdit#CatalogSearch:focus,
QComboBox#CatalogFilter:focus {
    border: 1px solid #B87930;
}

QComboBox#CatalogFilter QAbstractItemView {
    background-color: #1B2631;
    color: #E6EDF3;
    selection-background-color: #3B3022;
    selection-color: #F5B568;
    border: 1px solid #354555;
}

QTableView#CatalogTable {
    background-color: #151F29;
    alternate-background-color: #19242F;
    color: #DCE5ED;
    border: 1px solid #2D3A48;
    border-radius: 6px;
    selection-background-color: #3B3022;
    selection-color: #F5B568;
}

QTableView#CatalogTable::item {
    padding: 7px;
    border: none;
}

QTableView#CatalogTable QHeaderView::section {
    background-color: #202D39;
    color: #9EAFBF;
    border: none;
    border-bottom: 1px solid #354555;
    padding: 9px 7px;
    font-size: 8pt;
    font-weight: 700;
}

QLabel#CatalogDetailTitle {
    color: #F2F5F8;
    font-size: 17pt;
    font-weight: 700;
}

QLabel#CatalogDetailMetric {
    color: #F5B568;
    font-size: 10pt;
    font-weight: 700;
    padding: 7px 0;
}

QLabel#CatalogDetailText {
    color: #D2DCE5;
    font-size: 9pt;
}

QFrame#CatalogSeparator {
    color: #354555;
    max-height: 1px;
}
