
/* ==========================================
   J.A.R.V.I.S. 2.0
   Industrial Dark Theme
   ========================================== */

QWidget {
    background-color: #111820;
    color: #E6EDF3;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
    border: none;
}

/* Fenetre principale */

QMainWindow {
    background-color: #111820;
}

/* Barre superieure */

QFrame#TopBar {
    background-color: #151E28;
    border-bottom: 1px solid #2A3745;
}

QLabel#TopbarVersion {
    color: #F0A044;
    font-size: 9pt;
    font-weight: 700;
}

QLabel#TopbarProject {
    color: #96A7B7;
    font-size: 8pt;
    font-weight: 600;
}

/* Menu lateral */

QWidget#Sidebar {
    background-color: #151E28;
    border-right: 1px solid #2A3745;
}

QLabel#BrandTitle {
    color: #F2F5F8;
    font-size: 23pt;
    font-weight: 800;
}

QLabel#BrandSubtitle {
    color: #E99A3C;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 2px;
}

QLabel#SectionLabel {
    color: #718397;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}


QPushButton#NavButton {
    background-color: transparent;
    color: #AFBAC6;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 5px;
    padding: 10px 12px;
    text-align: left;
    font-size: 10pt;
    font-weight: 500;
}

QPushButton#NavButton:hover {
    background-color: #202D3A;
    color: #FFFFFF;
}

QPushButton#NavButton:checked {
    background-color: #342D25;
    color: #F4AE5C;
    border-left: 3px solid #F0A044;
    font-weight: 700;
}


QLabel#ProjectName {
    color: #CED7E0;
    font-size: 9pt;
    padding-top: 6px;
}

/* Titres */

QLabel#PageTitle {
    color: #F2F5F8;
    font-size: 23pt;
    font-weight: 700;
}

QLabel#PageSubtitle {
    color: #8FA0B0;
    font-size: 10pt;
}

QLabel#SectionTitle {
    color: #EDF2F6;
    font-size: 13pt;
    font-weight: 700;
}

/* Boutons de vue */



QPushButton#ModeButton {
    background-color: #202B36;
    color: #AEBBC8;
    border: 1px solid #344252;
    border-radius: 6px;
    min-width: 105px;
    min-height: 26px;
    padding: 6px 12px;
    font-size: 9pt;
}

QPushButton#ModeButton:hover {
    background-color: #293746;
}

QPushButton#ModeButton:checked {
    background-color: #3B3022;
    color: #F5B568;
    border: 1px solid #B87930;
    font-weight: 700;
}



/* Panneau d'accueil */

QFrame#WelcomePanel {
    background-color: #202D39;
    border: 1px solid #354555;
    border-radius: 11px;
}

QLabel#Eyebrow {
    color: #EAA04A;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}

QLabel#WelcomeTitle {
    color: #F4F6F8;
    font-size: 21pt;
    font-weight: 700;
}

QLabel#WelcomeDescription {
    color: #AEBBC8;
    font-size: 10pt;
}

/* Cartes */

QFrame#MetricCard {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 9px;
}

QFrame#MetricCard:hover {
    border: 1px solid #495A6C;
}

QLabel#MetricLabel {
    color: #94A5B5;
    font-size: 9pt;
    font-weight: 600;
}

QLabel#MetricValue {
    color: #F0F3F6;
    font-size: 23pt;
    font-weight: 700;
}

QLabel#MetricDescription {
    color: #8293A3;
    font-size: 8pt;
}

/* Bouton principal */

QPushButton#PrimaryButton {
    background-color: #E99536;
    color: #171D24;
    border: none;
    border-radius: 6px;
    padding: 11px 17px;
    font-size: 9pt;
    font-weight: 700;
}

QPushButton#PrimaryButton:hover {
    background-color: #F3AA53;
}

QPushButton#PrimaryButton:pressed {
    background-color: #C97D28;
}

/* Comportement general */

QPushButton {
    outline: none;
}

QToolTip {
    background-color: #263442;
    color: #FFFFFF;
    border: 1px solid #485B6E;
    padding: 6px;
}


/* ==========================================
   PROJECT MANAGER
   ========================================== */

QFrame#ProjectCard {
    background-color: #1B2631;
    border: 1px solid #2D3A48;
    border-radius: 9px;
}

QFrame#ProjectCard:hover {
    border: 1px solid #52677A;
    background-color: #202D39;
}

QFrame#EmptyProjectsCard {
    background-color: #1B2631;
    border: 1px dashed #425264;
    border-radius: 10px;
}

QLabel#ProjectTitle {
    color: #F1F4F7;
    font-size: 13pt;
    font-weight: 700;
}

QLabel#ProjectDescription {
    color: #AEBBC8;
    font-size: 9pt;
}

QLabel#ProjectMetadata {
    color: #8293A3;
    font-size: 8pt;
}

QLabel#ProjectCardIcon {
    color: #EAA04A;
    font-size: 25pt;
    font-weight: 600;
}

QLabel#EmptyProjectIcon {
    color: #EAA04A;
    font-size: 30pt;
}

QScrollArea#ProjectScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#ProjectContainer {
    background-color: transparent;
}

QLineEdit#FormInput,
QTextEdit#FormInput {
    background-color: #151F29;
    color: #E6EDF3;
    border: 1px solid #354555;
    border-radius: 5px;
    padding: 9px;
    selection-background-color: #B87930;
}

QLineEdit#FormInput:focus,
QTextEdit#FormInput:focus {
    border: 1px solid #E99536;
}

QLabel#DialogTitle {
    color: #F2F5F8;
    font-size: 17pt;
    font-weight: 700;
}

QPushButton#PrimarySmallButton {
    background-color: #E99536;
    color: #171D24;
    border: none;
    border-radius: 5px;
    padding: 8px 17px;
    font-weight: 700;
}

QPushButton#PrimarySmallButton:hover {
    background-color: #F3AA53;
}

QPushButton#SecondarySmallButton {
    background-color: #263441;
    color: #BBC7D2;
    border: 1px solid #3A4B5C;
    border-radius: 5px;
    padding: 8px 17px;
}

QPushButton#SecondarySmallButton:hover {
    background-color: #334657;
    color: #FFFFFF;
}
