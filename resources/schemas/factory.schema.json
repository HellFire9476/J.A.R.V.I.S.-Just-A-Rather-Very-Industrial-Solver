{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/factory.schema.json",
  "title": "J.A.R.V.I.S. Factory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "park_id", "name", "description", "scenario_ids", "created_at", "updated_at"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "format": "uuid"},
    "project_id": {"type": "string", "format": "uuid"},
    "park_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "description": {"type": "string", "maxLength": 500},
    "scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
